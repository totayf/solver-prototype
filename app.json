{
  "expo": {
    "name": "Solver",
    "slug": "solver",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "solver",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Sorunun fotoğrafını çekebilmen için Solver'ın kameraya erişmesi gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Galerinden soru fotoğrafı seçebilmen için Solver'ın fotoğraflarına erişmesi gerekiyor."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.kovanacademy.solver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Galerinden soru fotoğrafı seçebilmen için Solver'ın fotoğraflarına erişmesi gerekiyor.",
          "cameraPermission": "Sorunun fotoğrafını çekebilmen için Solver'ın kameraya erişmesi gerekiyor.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/icon.png"
  }
}
